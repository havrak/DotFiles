#!/usr/bin/env python3
import sys
import os

if len(sys.argv) < 2:
    sys.exit(0)

filepath = sys.argv[1]

# Ensure GTK can locate the active Wayland or X11 socket
if "WAYLAND_DISPLAY" not in os.environ and "DISPLAY" not in os.environ:
    for sock in ["wayland-0", "wayland-1"]:
        if os.path.exists(f"/run/user/{os.getuid()}/{sock}"):
            os.environ["WAYLAND_DISPLAY"] = sock
            break

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

print_op = Gtk.PrintOperation()
print_op.set_job_name(os.path.basename(filepath))
print_op.set_export_filename(filepath)

# PRINT_DIALOG runs a blocking modal event loop natively in Gtk3
res = print_op.run(Gtk.PrintOperationAction.PRINT_DIALOG, None)

if res == Gtk.PrintOperationResult.ERROR:
    sys.exit(1)

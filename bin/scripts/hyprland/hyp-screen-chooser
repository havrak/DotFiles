#!/usr/bin/env python3
import json
import subprocess
import os
import sys
import math
import csv
import re
from pathlib import Path

CONF_PATH = Path(os.path.expanduser("~/bin/scripts/files/hyp-monitors"))
LAYOUTS_DIR = Path(os.path.expanduser("~/bin/scripts/files/monitor-layouts"))
WAYBAR_CONF_DIR = Path(os.path.expanduser("~/.config/waybar"))
WAYBAR_OUTPUT_FILE = WAYBAR_CONF_DIR / "active-workspaces.jsonc"

EXTRA_WS = {"A": (21, "F1"), "B": (22, "F2"), "C": (23, "F3"), "D": (24, "F4"), "E": (25, "F5"), "F": (26, "F6")}
WS_MAPPING = {}
for i in range(1, 13):
    WS_MAPPING[str(i)] = {"id": i, "key": None}
for k, (wid, key) in EXTRA_WS.items():
    WS_MAPPING[k] = {"id": wid, "key": key}

def run_cmd(cmd):
    subprocess.run(cmd, shell=True)

def hyprctl(command):
    try:
        return subprocess.check_output(f"hyprctl {command}", shell=True).decode("utf-8").strip()
    except subprocess.CalledProcessError:
        return ""

def hyprctl_json(command):
    try:
        return json.loads(subprocess.check_output(f"hyprctl -j {command}", shell=True))
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return []

def notify(title, message):
    run_cmd(f'notify-send "{title}" "{message}"')

class MonitorManager:
    def __init__(self):
        self.monitors_all = hyprctl_json("monitors all")
        self.monitors_all.sort(key=lambda x: x.get("name", ""))
        self.internal = None
        self.external = None
        self.other_externals = []
        self._detect_monitors()

    def _detect_monitors(self):
        for mon in self.monitors_all:
            if mon["name"].startswith("eDP"):
                self.internal = mon
                break
        candidates = [m for m in self.monitors_all if m != self.internal and len(m.get("availableModes", [])) > 0]
        dp_mons = [m for m in candidates if "DP-" in m["name"]]
        hdmi_mons = [m for m in candidates if "HDMI-" in m["name"]]
        if dp_mons:
            self.external = dp_mons[0]
            self.other_externals = dp_mons[1:] + hdmi_mons
        elif hdmi_mons:
            self.external = hdmi_mons[0]
            self.other_externals = hdmi_mons[1:]

    def get_auto_scale(self, width_px, height_px, width_mm, height_mm):
        if width_mm == 0 or height_mm == 0: return 1.0
        diag_px = math.sqrt(width_px**2 + height_px**2)
        diag_in = math.sqrt(width_mm**2 + height_mm**2) / 25.4
        if diag_in == 0: return 1.0
        ppi = diag_px / diag_in
        if diag_in < 17.0 and ppi >= 170: return 1.25
        if diag_in >= 24.0 and ppi < 90: return 0.83
        return 1.0

    def get_monitor_signature(self):
        serials = []
        for m in self.monitors_all:
            s = str(m.get("serial", "")) + str(m.get("description", "")) + str(m.get("name", ""))
            serials.append(s)
        return "".join(sorted(serials)).replace(" ", "")

def safe_move_workspace(ws_id, monitor_name):
    workspaces = hyprctl_json("workspaces")
    if any(str(w.get("id", "")) == str(ws_id) or str(w.get("name", "")) == str(ws_id) for w in workspaces):
        run_cmd(f"hyprctl eval \"hl.dispatch(hl.dsp.workspace.move({{ workspace = '{ws_id}', monitor = '{monitor_name}' }}))\"")

def parse_ws_string(ws_str):
    if not ws_str or ws_str.lower() in ["none", ""]: return []
    ws_str = ws_str.replace(" ", "")
    result = []
    for part in ws_str.split(","):
        if "-" in part:
            start, end = part.split("-")
            if start.isdigit() and end.isdigit():
                result.extend([str(i) for i in range(int(start), int(end)+1)])
            elif start in EXTRA_WS and end in EXTRA_WS:
                keys = list(EXTRA_WS.keys())
                try:
                    result.extend(keys[keys.index(start):keys.index(end)+1])
                except ValueError: pass
        else:
            result.append(part)
    return result

def setup_workspaces(monitor_ws_map):
    for key in [v[1] for v in EXTRA_WS.values()]:
        run_cmd(f"hyprctl eval \"hl.unbind('ALT + {key}')\"")
        run_cmd(f"hyprctl eval \"hl.unbind('ALT + SHIFT + {key}')\"")

    for mon, ws_list in monitor_ws_map.items():
        for ws_label in ws_list:
            if ws_label in WS_MAPPING:
                wid = WS_MAPPING[ws_label]["id"]
                key = WS_MAPPING[ws_label]["key"]
                run_cmd(f"hyprctl eval \"hl.workspace_rule({{ workspace = '{wid}', monitor = '{mon}' }})\"")
                safe_move_workspace(wid, mon)
                if key:
                    run_cmd(f"hyprctl eval \"hl.bind('ALT + {key}', hl.dsp.focus({{ workspace = '{wid}' }}))\"")
                    run_cmd(f"hyprctl eval \"hl.bind('ALT + SHIFT + {key}', hl.dsp.window.move({{ workspace = '{wid}' }}))\"")

def generate_waybar_config(monitor_ws_map):
    config = {
            "hyprland/workspaces": {
                "disable-scroll": True,
                "all-outputs": False,
                "format": "{icon}",
                "format-icons": {
                    "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V", "6": "VI",
                    "7": "VII", "8": "VIII", "9": "IX", "10": "X", "11": "XI", "12": "XII",
                    "21": "A", "22": "B", "23": "C", "24": "D", "25": "E", "26": "F"
                    },
                "persistent-workspaces": {}
                }
            }
    for mon, ws_list in monitor_ws_map.items():
        ids = []
        for w in ws_list:
            if w in WS_MAPPING: ids.append(WS_MAPPING[w]["id"])
        if ids:
            config["hyprland/workspaces"]["persistent-workspaces"][mon] = ids

    WAYBAR_CONF_DIR.mkdir(parents=True, exist_ok=True)
    with open(WAYBAR_OUTPUT_FILE, "w") as f:
        json.dump(config, f, indent=4)

def apply_layout(layout_name, mgr):
    layout_path = LAYOUTS_DIR / f"{layout_name}.csv"
    if not layout_path.exists():
        notify("Error", f"Layout {layout_name} not found")
        return

    with open(layout_path, mode='r') as f:
        rules = list(csv.DictReader(f))

    matched = {}
    master_mon = None

    for rule in rules:
        target = rule.get("monitor", "").strip()
        obj = None
        if target == "lab:internal": obj = mgr.internal
        elif target == "lab:external": obj = mgr.external
        elif target.startswith("mod:"):
            model = target.replace("mod:", "").strip()
            for m in mgr.monitors_all:
                if model in m.get("description", "") or model in m.get("make", "") or model in m.get("model", ""):
                    obj = m
                    break
        if obj:
            matched[obj["name"]] = {"rule": rule, "data": obj}
            if rule.get("mode") == "master":
                master_mon = obj["name"]

    if not master_mon and matched:
        master_mon = list(matched.keys())[0]

    configs = {}
    for name, info in matched.items():
        r = info["rule"]
        d = info["data"]


        rfr = r.get("refresh_rate", 60);
        max_rf = 1000

        if rfr != "default":
            max_rf = float(rfr)

        modes = []
        for m in d.get("availableModes", []):
            p = m.split("@")
            res = p[0].split("x")
            modes.append((int(res[0]), int(res[1]), float(p[1].replace("Hz", ""))))

        req_res = r.get("resolution", "default").strip()
        if req_res != "default":
            try:
                tw, th = map(int, req_res.split("x"))
                modes = [m for m in modes if m[0] == tw and m[1] == th]
            except ValueError:
                pass

        modes = [m for m in modes if m[2] <= max_rf + 1.0]
        modes.sort(key=lambda x: (x[0], x[1], x[2]), reverse=True)
        w, h, rf = modes[0] if modes else (1920, 1080, 60.0)

        scale_rule = str(r.get("scale", "default")).strip().lower()
        if scale_rule == "default":
            scale = mgr.get_auto_scale(w, h, d.get("physicalWidth", 0), d.get("physicalHeight", 0))
        elif scale_rule == "none":
            scale = 1.0
        else:
            try:
                scale = float(scale_rule)
            except ValueError:
                scale = 1.0

        configs[name] = {
                "rule": r, "w": w, "h": h, "rf": rf, "scale": scale,
                "log_w": w / scale, "log_h": h / scale,
                "x": 0, "y": 0, "mirror": None
                }

    if master_mon in configs:
        mc = configs[master_mon]
        for name, c in configs.items():
            if name == master_mon: continue
            pos = c["rule"].get("position", "master").strip().lower()
            mode = c["rule"].get("mode", "default").strip().lower()
            if mode == "mirror":
                c["mirror"] = master_mon
            elif pos == "west":
                c["x"] = mc["x"] - c["log_w"]
                c["y"] = mc["y"]
            elif pos == "east":
                c["x"] = mc["x"] + mc["log_w"]
                c["y"] = mc["y"]
            elif pos == "north":
                c["x"] = mc["x"]
                c["y"] = mc["y"] - c["log_h"]
            elif pos == "south":
                c["x"] = mc["x"]
                c["y"] = mc["y"] + mc["log_h"]

    min_x = min([c["x"] for c in configs.values()], default=0)
    min_y = min([c["y"] for c in configs.values()], default=0)

    for c in configs.values():
        c["x"] = int(c["x"] - min_x)
        c["y"] = int(c["y"] - min_y)

    for m in mgr.monitors_all:
        if m["name"] not in configs:
            run_cmd(f"hyprctl eval \"hl.monitor({{ output = '{m['name']}', disabled = true }})\"")
        else:
            c = configs[m["name"]]
            if c["mirror"]:
                run_cmd(f"hyprctl eval \"hl.monitor({{ output = '{m['name']}', mode = '{c['w']}x{c['h']}@{c['rf']}', position = '{c['x']}x{c['y']}', scale = {c['scale']}, mirror = '{c['mirror']}' }})\"")
            else:
                run_cmd(f"hyprctl eval \"hl.monitor({{ output = '{m['name']}', mode = '{c['w']}x{c['h']}@{c['rf']}', position = '{c['x']}x{c['y']}', scale = {c['scale']} }})\"")

    monitor_ws_map = {}
    for name, c in configs.items():
        if not c["mirror"]:
            ws_str = c["rule"].get("workspaces", "")
            monitor_ws_map[name] = parse_ws_string(ws_str)

    setup_workspaces(monitor_ws_map)
    generate_waybar_config(monitor_ws_map)

    save_state(layout_name, mgr)
    run_cmd(os.path.expanduser("~/bin/scripts/wm-agnostic/setbg &"))
    run_cmd(os.path.expanduser("~/bin/scripts/hyprland/waybar-launch &"))

def save_state(layout, mgr):
    CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(CONF_PATH, "w") as f:
        f.write(f"{layout}\n{mgr.get_monitor_signature()}")

def restore_state(mgr):
    if not CONF_PATH.exists():
        apply_layout("|1 laptop|", mgr)
        return
    with open(CONF_PATH, "r") as f:
        lines = f.readlines()
        if len(lines) < 2 and lines[1].strip() == mgr.get_monitor_signature():
            apply_layout(lines[0].strip(), mgr)
        else:
            apply_layout("|1 laptop|", mgr)


def main():
    mgr = MonitorManager()
    LAYOUTS_DIR.mkdir(parents=True, exist_ok=True)
    layouts = [f.stem for f in LAYOUTS_DIR.glob("*.csv")]

    def layout_sort_key(name):
        match = re.match(r'^\|(\d+)', name)
        if match:
            return (0, int(match.group(1)), name)
        return (1, 0, name)

    layouts.sort(key=layout_sort_key)

    choice = sys.argv[1] if len(sys.argv) > 1 else ""
    if not choice and layouts:
        try:
            res = subprocess.run("echo '" + "\n".join(layouts + ['|restore|']) + "' | tofi --prompt-text 'Monitor Setup'", shell=True, stdout=subprocess.PIPE)
            choice = res.stdout.decode("utf-8").strip()
        except Exception: pass
    if choice == "|restore|": restore_state(mgr)
    elif choice in layouts:
        run_cmd("hyprctl reload")
        apply_layout(choice, mgr)

if __name__ == "__main__": main()
